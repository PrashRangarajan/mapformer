\@writefile{toc}{\contentsline {paragraph}{The paper task.}{3}{section*.9}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Paper task under the converged torus recipe: accuracy predicting the observation at revisited cells of a held-out map, trained at $T=128$, evaluated up to eight times that; 6 arms $\times $ 8 seeds in one batch, pre-registered. \emph  {Enc.}: RoPE = rotation only; PoPE = content-dependent magnitude plus rotation. \emph  {Position}: index = token index; path-int.\ = MapFormer's running sum of learned per-token increments, bottleneck rank $r$. \texttt  {Vanilla} = MapFormer-WM; \texttt  {RoPE} = MapFormer with index rotation. Top rows: accuracy mean $\pm $ sd. Bottom rows: main effects on accuracy, each averaged over the other factor and paired by seed; \emph  {position} = path-integrated minus index; \emph  {encoding} = PoPE minus RoPE. Every main effect shown is detectable. Effects are on raw accuracy; why no loss-matched position effect is reported is explained in the text. Blank floor about 0.51 at $T=128$. Reading: path integration is the larger factor at every length; the encoding effect is detectably negative at training length and positive beyond it.\relax }}{4}{table.caption.8}\protected@file@percent }
\newlabel{tab:paper2x2}{{2}{4}{Paper task under the converged torus recipe: accuracy predicting the observation at revisited cells of a held-out map, trained at $T=128$, evaluated up to eight times that; 6 arms $\times $ 8 seeds in one batch, pre-registered. \emph {Enc.}: RoPE = rotation only; PoPE = content-dependent magnitude plus rotation. \emph {Position}: index = token index; path-int.\ = MapFormer's running sum of learned per-token increments, bottleneck rank $r$. \arm {Vanilla} = MapFormer-WM; \arm {RoPE} = MapFormer with index rotation. Top rows: accuracy mean $\pm $ sd. Bottom rows: main effects on accuracy, each averaged over the other factor and paired by seed; \emph {position} = path-integrated minus index; \emph {encoding} = PoPE minus RoPE. Every main effect shown is detectable. Effects are on raw accuracy; why no loss-matched position effect is reported is explained in the text. Blank floor about 0.51 at $T=128$. Reading: path integration is the larger factor at every length; the encoding effect is detectably negative at training length and positive beyond it.\relax }{table.caption.8}{}}
\@writefile{toc}{\contentsline {paragraph}{Why the position effect is not loss-matched.}{4}{section*.10}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Other tasks.}{4}{section*.11}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {4}Claim 2: the environment must make displacement a function of the token}{4}{section.4}\protected@file@percent }
\newlabel{sec:claim2}{{4}{4}{Claim 2: the environment must make displacement a function of the token}{section.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Torus knob sweep: accuracy predicting the observation at revisited cells of a held-out map, at $T=128$. Rotate = turn and forward actions (displacement depends on heading); allocentric record = same dynamics, each action token the realised displacement. Path-integrated = \texttt  {Vanilla} (MapFormer-WM); index = \texttt  {RoPE} (position = token index). Mean $\pm $ sd, $n=8$ per arm; effect = difference of means; floor = measured no-model baseline. All arms trained 16 epochs; rotate and allocentric at 392 batches per epoch (matched supervised events), baseline and combined at 98. No uncertainty was recorded for the effects. The combined condition's order-3 answer-stream gate reached 0.634 against a 0.536 marginal ($n=3$ gate), so its effect is approximate. Reading: rotation removes most of the effect, and recording the realised displacement restores it.\relax }}{5}{table.caption.12}\protected@file@percent }
\newlabel{tab:knob}{{3}{5}{Torus knob sweep: accuracy predicting the observation at revisited cells of a held-out map, at $T=128$. Rotate = turn and forward actions (displacement depends on heading); allocentric record = same dynamics, each action token the realised displacement. Path-integrated = \arm {Vanilla} (MapFormer-WM); index = \arm {RoPE} (position = token index). Mean $\pm $ sd, $n=8$ per arm; effect = difference of means; floor = measured no-model baseline. All arms trained 16 epochs; rotate and allocentric at 392 batches per epoch (matched supervised events), baseline and combined at 98. No uncertainty was recorded for the effects. The combined condition's order-3 answer-stream gate reached 0.634 against a 0.536 marginal ($n=3$ gate), so its effect is approximate. Reading: rotation removes most of the effect, and recording the realised displacement restores it.\relax }{table.caption.12}{}}
