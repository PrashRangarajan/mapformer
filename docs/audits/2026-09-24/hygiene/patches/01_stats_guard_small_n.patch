+def mde_t(sd: float, n: int, alpha: float = 0.05, power: float = 0.80) -> float:
+    """Small-sample MDE: (t_{1-alpha/2,n-1} + t_{power,n-1}) * sd / sqrt(n)."""
+    k = _st.t.ppf(1 - alpha / 2, n - 1) + _st.t.ppf(power, n - 1)
+    return float(k * sd / math.sqrt(n))
+
+
+def signflip_p(d) -> float:
+    """Exact two-sided sign-flip (paired permutation) p for mean(d) = 0. Valid for
+    bimodal seeds. Minimum achievable p is 2 / 2**n (0.25 at n=3)."""
+    import itertools
+    d = np.asarray(list(d), float)
+    if d.size > 20:
+        rng = np.random.default_rng(0)
+        signs = rng.choice((1.0, -1.0), size=(200_000, d.size))
+        return float(((np.abs((signs * d).mean(1)) >= abs(d.mean()) - 1e-12).sum() + 1) / 200_001)
+    signs = np.array(list(itertools.product((1.0, -1.0), repeat=d.size)))
+    return float((np.abs((signs * d).mean(1)) >= abs(d.mean()) - 1e-12).mean())
+
+
